# 伴语 (Banyu) 环境变量配置

# 数据库（开发用 SQLite，生产改 postgresql+asyncpg）
DATABASE_URL=sqlite+aiosqlite:///./banyu.db

# JWT 密钥（生产环境必须修改！）
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# API key 加密主密钥（生产环境必须修改！）
ENCRYPT_KEY=change-me-in-production

# 跨域
CORS_ORIGINS=["http://localhost:3000"]

# Web Push VAPID（用 pywebpush 生成）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 火山引擎 TTS（声音克隆用，非 ARK LLM key）
VOLC_TTS_TOKEN=
