# 数据库（开发用 SQLite；生产/记忆功能改 postgresql+asyncpg://user:pass@host/db）
DATABASE_URL=sqlite+aiosqlite:///./banyu.db

# JWT（生产务必换随机长串）
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 跨域（前端地址）
CORS_ORIGINS=["http://localhost:3000"]

# API key 加密主密钥（生产务必换）
ENCRYPT_KEY=change-me-in-production

# Web Push VAPID（npx web-push generate-vapid-keys 生成）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
